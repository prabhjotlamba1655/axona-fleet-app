{
  "expo": {
    "name": "Axona Fleet",
    "displayName": "Axona Fleet Management",
    "slug": "axona-fleet-management",
    "version": "2.4.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#102C50",
    "primaryColor": "#102C50",
    "ios": {
      "bundleIdentifier": "com.axonasoftware.fleet",
      "buildNumber": "24",
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": ["fetch", "remote-notification"],
        "NSLocationWhenInUseUsageDescription": "Axona requires access to your location to plot driver routes and live vehicle navigation.",
        "NSFaceIDUsageDescription": "Enable biometric authentication to securely access Axona Fleet Management."
      }
    },
    "android": {
      "package": "com.axonasoftware.fleet",
      "versionCode": 24,
      "adaptiveIcon": {
        "backgroundColor": "#102C50"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "VIBRATE",
        "USE_BIOMETRIC",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro"
    }
  }
}
